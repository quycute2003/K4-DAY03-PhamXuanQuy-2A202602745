# ==========================================
# MULTI-PROVIDER LLM ADAPTER CONFIGURATION
# ==========================================

# Lựa chọn LLM Provider: "gemini", "openai", "anthropic", "openrouter", hoặc "mock" (offline)
LLM_PROVIDER=gemini

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash
# Giới hạn Free Tier thường yêu cầu giãn cách giữa các request liên tiếp
GEMINI_REQUEST_INTERVAL_SECONDS=13
GEMINI_MAX_RETRIES=5
# Giữ false khi nghiệm thu để không tạo trace trộn Gemini/Mock
GEMINI_ALLOW_MOCK_FALLBACK=false

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_ALLOW_MOCK_FALLBACK=false
# LLM_MODEL=gpt-4o-mini

# Anthropic API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# LLM_MODEL=claude-3-5-haiku-20241022

# MCP Configuration
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8000
